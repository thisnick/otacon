# Orchestrator Docker image (Pi-based, post-Phase-A rename).
#
# Stage 1 (builder): pnpm install across the workspace, then
# `pnpm --filter orchestrator build` runs `tsc` against
# `src/orchestrator/`. Output: `src/orchestrator/dist/`.
#
# Stage 2 (runtime): copies `dist/`, the workspace `package.json` files,
# pnpm-lock + workspace config, then re-installs prod-only dependencies
# so `node_modules` lives at the repo root + per-package pnpm symlinks
# resolve. CMD launches the compiled CLI's `serve` subcommand.
#
# No Nitro, no SWC plugin, no Rollup workflow patches — this is a plain
# Hono + Node 22 server compiled by tsc. The web UI is built by Vite
# in the same builder stage and shipped inside the server image so the
# orchestrator hosts the UI same-origin at `/`.

# ---------- Stage 1: build ----------
FROM node:22-bookworm-slim AS builder

# Build deps for native modules. `sharp` is a runtime dep; on arm64 the
# prebuilt binary usually loads fine, but pkg-config keeps the
# install-time fall-back working when the prebuilt mismatches.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

WORKDIR /src

# Copy lock + workspace manifests first for better layer caching.
# Orchestrator depends on `otacon-cli` (workspace:*) which pulls
# api-types, so all package.json files must be present before install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY src/cli/package.json ./src/cli/
COPY src/orchestrator/package.json ./src/orchestrator/
COPY src/orchestrator/web/package.json ./src/orchestrator/web/
RUN pnpm install --frozen-lockfile

# Now copy sources and build only the orchestrator package + web bundle.
COPY src/cli/ ./src/cli/
COPY src/orchestrator/ ./src/orchestrator/
RUN pnpm --filter orchestrator build
RUN pnpm --filter orchestrator-web build

# ---------- Stage 2: runtime ----------
FROM node:22-bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

# Non-root user owning the data dir.
RUN groupadd -r orchestrator && useradd -r -g orchestrator -d /data -m orchestrator \
    && mkdir -p /data/orchestrator && chown -R orchestrator:orchestrator /data

WORKDIR /app

# Workspace manifests — needed at runtime so pnpm's per-package
# `node_modules` symlinks (workspace:* dependencies) resolve.
COPY --from=builder /src/package.json /src/pnpm-lock.yaml /src/pnpm-workspace.yaml ./
COPY --from=builder /src/src/cli/package.json ./src/cli/
COPY --from=builder /src/src/orchestrator/package.json ./src/orchestrator/
COPY --from=builder /src/src/orchestrator/web/package.json ./src/orchestrator/web/

# CLI sources — `otacon-cli` is consumed at runtime via `workspace:*`
# from the orchestrator package. The CLI runs from source via tsx in
# dev; here we ship sources so the workspace symlink resolves at
# require-time.
COPY --from=builder /src/src/cli/ ./src/cli/

# Compiled orchestrator output. tsc emits to `dist/` mirroring the
# input layout under `rootDir: "."`, so the entry is at
# `dist/src/cli/index.js`.
COPY --from=builder /src/src/orchestrator/dist ./src/orchestrator/dist

# Built web UI bundle. The server's static handler resolves the bundle
# via `import.meta.url` from `dist/src/server/routes/static.js` going
# up three levels + `web/dist` — so the bundle must live at
# `src/orchestrator/dist/web/dist/`.
COPY --from=builder /src/src/orchestrator/web/dist ./src/orchestrator/dist/web/dist

# Prod-only install. With sources + manifests in place, pnpm rebuilds
# the workspace `node_modules` graph at this fresh location; only
# production dependencies are linked (skips tsx, typescript, etc).
RUN pnpm install --frozen-lockfile --prod \
    && pnpm store prune

ENV NODE_ENV=production
ENV ORCHESTRATOR_DATA_DIR=/data/orchestrator
ENV PORT=9090

EXPOSE 9090

USER orchestrator
WORKDIR /app

VOLUME ["/data/orchestrator"]

CMD ["node", "--no-warnings", "src/orchestrator/dist/src/cli/index.js", "serve", "--port", "9090"]
