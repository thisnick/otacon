# Registry (node-facing) Tailscale auth key — tag:registry, reusable, ephemeral
TS_AUTH_KEY_REGISTRY=tskey-auth-...

# Optional: comma-separated Tailscale user emails allowed admin access
# OTACON_ADMIN_USERS=user@tailnet.ts.net

# Container image repo
OTACON_REPO=otacon-dev

# NOTE: Admin does NOT have its own Tailscale sidecar. It binds to host
# port 9090 via bridge networking. In dev, reachable via the Pi's existing
# Tailscale identity (http://otacon-pi:9090). In production, bind to
# localhost and front with a Node.js BFF that handles user auth.
