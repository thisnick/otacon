FROM debian:trixie-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates \
    libcurl4-openssl-dev libpcsclite-dev \
    && rm -rf /var/lib/apt/lists/*

# Pinned: the build running on the Pi since 2026-09 (lpac 2.3.0.r456). lpac's
# main no longer configures with these options (2026-10-17).
ARG LPAC_REF=3ff35594ec15062a3ed10c3da1c26eb0a13390b8
RUN git clone https://github.com/estkme-group/lpac.git /lpac \
    && cd /lpac \
    && git checkout ${LPAC_REF} \
    && mkdir build && cd build \
    && cmake .. -DLPAC_WITH_APDU_AT=ON \
    && make -j$(nproc)

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Modem management
    modemmanager \
    libqmi-utils \
    libmbim-utils \
    # AT command tools
    minicom \
    picocom \
    # General utilities
    curl \
    libcurl4 \
    usbutils \
    iproute2 \
    net-tools \
    jq \
    python3 \
    python3-serial \
    && rm -rf /var/lib/apt/lists/*

# Install lpac — preserve build directory structure (RUNPATH is hardcoded)
COPY --from=builder /lpac/build/ /lpac/build/
RUN ln -s /lpac/build/src/lpac /usr/local/bin/lpac
ENV LD_LIBRARY_PATH=/lpac/build:/lpac/build/driver:/lpac/build/utils:/lpac/build/euicc

# Simple entrypoint that keeps container running
CMD ["bash", "-c", "echo 'otacon-voice ready. Use docker exec to interact.' && sleep infinity"]
