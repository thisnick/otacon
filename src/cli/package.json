{
  "name": "otacon-cli",
  "version": "0.1.0",
  "description": "CLI for otacon phone automation",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "bin": {
    "otacon": "./dist/index.js"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.json -o src/api-types.ts",
    "generate:registry": "openapi-typescript ../../docs/openapi/registry.json -o src/registry-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
