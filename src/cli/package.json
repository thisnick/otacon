{
  "name": "otacon-cli",
  "version": "0.1.0",
  "description": "CLI for otacon phone automation",
  "type": "module",
  "bin": {
    "otacon": "./dist/index.js"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.json -o src/api-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
