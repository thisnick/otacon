{
  "name": "otacon-orchestrator",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "orchestrator": "node --no-warnings --import tsx/esm src/index.ts",
    "dev": "nitro dev",
    "build:server": "nitro build",
    "prepare:server": "nitro prepare",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "pnpm test:unit && pnpm test:e2e:smoke && pnpm test:e2e:approval-flow && pnpm test:e2e:failure-flow && pnpm test:e2e:trace-route && pnpm test:e2e:accounts-teams && pnpm test:e2e:messages-route && pnpm test:e2e:cli-subcommands && pnpm test:e2e:web-ui",
    "test:unit": "tsx ../../tests/orchestrator/unit/test-storage.ts && tsx ../../tests/orchestrator/unit/test-mutating.ts && tsx ../../tests/orchestrator/unit/test-annotate.ts && tsx ../../tests/orchestrator/unit/test-config.ts",
    "test:e2e:smoke": "tsx ../../tests/orchestrator/e2e/test-workflow-smoke.ts",
    "test:e2e:approval-flow": "tsx ../../tests/orchestrator/e2e/test-approval-flow.ts",
    "test:e2e:failure-flow": "tsx ../../tests/orchestrator/e2e/test-failure-flow.ts",
    "test:e2e:trace-route": "tsx ../../tests/orchestrator/e2e/test-trace-route.ts",
    "test:e2e:accounts-teams": "tsx ../../tests/orchestrator/e2e/test-accounts-teams.ts",
    "test:e2e:messages-route": "tsx ../../tests/orchestrator/e2e/test-messages-route.ts",
    "test:e2e:cli-subcommands": "tsx ../../tests/orchestrator/e2e/test-cli-subcommands.ts",
    "test:e2e:web-ui": "tsx ../../tests/orchestrator/e2e/test-web-ui.ts",
    "test:e2e:phase1": "tsx ../../tests/orchestrator/e2e/phase1-xhs-scroll.ts",
    "test:e2e:phase2": "tsx ../../tests/orchestrator/e2e/phase2-xhs-actions.ts",
    "test:e2e:phase3": "tsx ../../tests/orchestrator/e2e/phase3-streaming.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.0",
    "@workflow/ai": "^4.1.0",
    "@workflow/core": "^4.2.4",
    "@workflow/world-local": "^4.1.0",
    "ai": "7.0.0-beta.111",
    "commander": "^13.0.0",
    "dotenv": "^16.4.0",
    "h3": "2.0.1-rc.5",
    "just-bash": "^2.14.0",
    "nitro": "3.0.1-alpha.1",
    "otacon-cli": "workspace:*",
    "rollup": "^4.60.2",
    "sharp": "^0.33.0",
    "ulid": "^2.3.0",
    "workflow": "^4.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
