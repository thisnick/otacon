{
  "name": "otacon-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "orchestrator": "node --no-warnings --import tsx/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "pnpm test:unit",
    "test:unit": "tsx ../../tests/orchestrator/unit/test-storage.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx tsx src/db/migrate.ts"
  },
  "dependencies": {
    "ai": "7.0.0-beta.111",
    "@ai-sdk/gateway": "^3.0.0",
    "workflow": "^4.2.0",
    "@workflow/world-local": "^4.1.0",
    "@workflow/ai": "^4.1.0",
    "just-bash": "^2.14.0",
    "drizzle-orm": "^0.40.0",
    "@neondatabase/serverless": "^1.0.0",
    "commander": "^13.0.0",
    "zod": "^3.24.0",
    "sharp": "^0.33.0",
    "dotenv": "^16.4.0",
    "ulid": "^2.3.0",
    "otacon-cli": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "drizzle-kit": "^0.31.0",
    "@types/node": "^22.0.0"
  }
}
