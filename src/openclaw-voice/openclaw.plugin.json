{
  "id": "otacon-voice",
  "name": "Otacon Voice",
  "description": "Phone calls through otacon phones and Twilio numbers, run by a realtime voice model.",
  "version": "3.2.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "otacon_call"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "realtime.providers.*.apiKey",
          "expected": "string"
        },
        {
          "path": "menu.decisions.apiKey",
          "expected": "string"
        },
        {
          "path": "menu.transcription.apiKey",
          "expected": "string"
        },
        {
          "path": "lines.*.authToken",
          "expected": "string"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "lines": {
        "type": "array",
        "minItems": 1,
        "description": "The phone lines: otacon phones and Twilio numbers",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "What the agent picks with otacon_call's line, e.g. sim or twilio"
            },
            "provider": {
              "type": "string",
              "enum": [
                "otacon",
                "twilio"
              ]
            },
            "number": {
              "type": "string",
              "description": "The line's number (E.164), shown to the agent; Twilio lines use fromNumber"
            },
            "url": {
              "type": "string",
              "description": "otacon host base URL, e.g. https://otacon-pi.example.ts.net:8080"
            },
            "phoneId": {
              "type": "string",
              "description": "host phone id, e.g. phone-r5ct60sd"
            },
            "takeover": {
              "type": "boolean"
            },
            "accountSid": {
              "type": "string",
              "description": "Twilio account SID"
            },
            "authToken": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ],
              "description": "Twilio auth token: a string or a SecretRef"
            },
            "fromNumber": {
              "type": "string",
              "description": "The Twilio number (E.164) calls come from and to"
            },
            "publicUrl": {
              "type": "string",
              "description": "Where Twilio reaches this line's routes, which the gateway serves at /otacon-voice/twilio/<id>, e.g. https://host.ts.net/otacon-voice/twilio/<id>"
            }
          },
          "required": [
            "id",
            "provider"
          ]
        }
      },
      "defaultLine": {
        "type": "string",
        "description": "The line calls go out on unless otacon_call names one (default: the first)"
      },
      "listen": {
        "type": "object",
        "additionalProperties": false,
        "description": "Listen-in (otacon_listen): the number a call may be played to, and the Twilio line that dials it (default: the first Twilio line)",
        "properties": {
          "to": {
            "type": "string",
            "description": "E.164 number to call for listen-in (the owner's)"
          },
          "line": {
            "type": "string",
            "description": "Id of the Twilio line that places the listening call"
          }
        },
        "required": [
          "to"
        ]
      },
      "agentId": {
        "type": "string"
      },
      "ownerName": {
        "type": "string"
      },
      "assistantName": {
        "type": "string"
      },
      "inboundGreeting": {
        "type": "string",
        "description": "Included in the voice model's first words when it answers an incoming call (default \"Hello! How can I help you today?\"; empty: it waits for the caller)"
      },
      "inboundPolicy": {
        "type": "string",
        "enum": [
          "disabled",
          "allowlist"
        ]
      },
      "allowFrom": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{6,14}$"
        }
      },
      "sessionScope": {
        "type": "string",
        "enum": [
          "per-phone",
          "per-call",
          "main"
        ]
      },
      "inboundSessionKey": {
        "type": "string",
        "pattern": "^agent:"
      },
      "toolPolicy": {
        "type": "string",
        "enum": [
          "safe-read-only",
          "owner",
          "none"
        ]
      },
      "consultPolicy": {
        "type": "string",
        "enum": [
          "auto",
          "substantive",
          "always"
        ]
      },
      "responseModel": {
        "type": "string"
      },
      "consultThinkingLevel": {
        "type": "string",
        "enum": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "adaptive",
          "max",
          "ultra"
        ]
      },
      "consultFastMode": {
        "type": "boolean"
      },
      "responseTimeoutMs": {
        "type": "number"
      },
      "realtime": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "instructions": {
            "type": "string"
          },
          "agentContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "includeIdentity": {
                "type": "boolean"
              },
              "includeWorkspaceFiles": {
                "type": "boolean"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "maxChars": {
                "type": "number"
              }
            }
          }
        }
      },
      "contacts": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "number": {
              "type": "string",
              "pattern": "^\\+[1-9]\\d{6,14}$"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "number"
          ]
        }
      },
      "menu": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "transcription": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "delay": {
                "type": "string",
                "enum": [
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh"
                ]
              },
              "apiKey": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          },
          "decisions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "apiKey": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          },
          "checkEverySeconds": {
            "type": "number"
          },
          "threshold": {
            "type": "number"
          }
        }
      },
      "holdCapSeconds": {
        "type": "number",
        "description": "Longest hold on a call an agent places before the phone-menu navigator hangs up (seconds); otacon_call's holdLimitMinutes overrides it per call"
      },
      "maxCallSeconds": {
        "type": "number"
      },
      "ringTimeoutSeconds": {
        "type": "number"
      }
    },
    "required": [
      "lines"
    ]
  }
}
