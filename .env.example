# Deploy
PI_HOST=otacon-pi
PI_USER=nick
OTACON_REPO=otacon-dev

# Secrets
VNC_PASSWORD=
TS_AUTH_KEY=

# Tailscale (optional, default: system hostname)
TS_HOSTNAME=otacon-pi

# Display
DISPLAY_NUM=50
DISPLAY_RESOLUTION=540x1204
SCRCPY_MAX_FPS=15
SCRCPY_BITRATE=2M
SCRCPY_MAX_SIZE=1204

# VNC
VNC_PORT=5900

# WiFi AP (Pi creates access point for phone — bypasses network proxy)
WIFI_AP_SSID=OtaconAP
WIFI_AP_PASSWORD=

# Audio
AUDIO_PORT=8080
AUDIO_BACKEND=alsa
ALSA_CAPTURE_DEVICE=plughw:Device,0
ALSA_PLAYBACK_DEVICE=plughw:Device,0
# Bluetooth audio profile: sco = calls (HFP, 16kHz), a2dp = media (A2DP, resampled to 16kHz)
# BLUEALSA_DEVICE=bluealsa:DEV=00:00:00:00:00:00,PROFILE=sco

# Watchtower (auto-update)
WATCHTOWER_POLL_INTERVAL=300

# Optional. If set on first boot, the registry uses this exact token instead
# of generating a random one. Must start with "otc_admin_" and be 74 chars
# total. Lets you check a known-good admin token into your secrets store.
# If unset, the registry generates a random token and prints it to stderr.
REGISTRY_BOOTSTRAP_ADMIN_TOKEN=

# ── Orchestrator VPS deploy (Phase 5) ──────────────────────────────
# OpenTofu reads these directly via tofu/.envrc.example (direnv). All
# values self-contained in this repo's .env — no sister-repo dependency.

# OCI auth — minted at https://cloud.oracle.com/identity/users/<your-user>/api-keys
TF_VAR_encryption_passphrase=
TF_VAR_tenancy_ocid=
TF_VAR_user_ocid=
TF_VAR_fingerprint=
TF_VAR_region=us-sanjose-1
TF_VAR_compartment_ocid=
# Path to the .pem private key matching the API key's fingerprint above.
TF_VAR_private_key_path=

# Tailscale auth key for the orchestrator VPS. If unset,
# tofu/.envrc.example falls back to TS_AUTH_KEY_REGISTRY.
TS_AUTH_KEY_ORCHESTRATOR=

# Tailnet domain (typically tail0437b8.ts.net).
TS_TAILNET_DOMAIN=tail0437b8.ts.net

# ghcr.io credentials so Watchtower on the VPS can pull updated images.
# After making the package public, the token is unused by the VM but
# cloud-init's `docker login ghcr.io` still runs.
GHCR_PULL_USER=thisnick
GHCR_PULL_TOKEN=

# Bearer token the orchestrator presents when calling the otacon registry.
# Should equal REGISTRY_BOOTSTRAP_ADMIN_TOKEN above.
OTACON_TOKEN=

# Vercel AI Gateway key for model calls.
AI_GATEWAY_API_KEY=
