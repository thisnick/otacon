{
  "name": "otacon",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure-as-code for a Raspberry Pi phone kiosk",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r run build",
    "generate": "pnpm -r run generate",
    "typecheck": "pnpm -r run typecheck",
    "ui-dev": "pnpm --filter orchestrator-web dev",
    "ui-build": "pnpm --filter orchestrator-web build",
    "cli": "pnpm --filter otacon-cli exec node --no-warnings --import tsx/esm src/index.ts",
    "dev": "concurrently -k -n server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter orchestrator dev",
    "dev:web": "pnpm --filter orchestrator-web dev",
