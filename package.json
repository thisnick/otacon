{
  "name": "otacon",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure-as-code for a Raspberry Pi phone kiosk",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r run build",
    "generate": "pnpm -r run generate",
    "typecheck": "pnpm -r run typecheck",
    "ui-dev": "pnpm --filter orchestrator-web dev",
    "ui-build": "pnpm --filter orchestrator-web build",
    "cli": "pnpm --filter otacon-cli exec node --no-warnings --import tsx/esm src/index.ts",
    "orchestrator": "pnpm --filter orchestrator orchestrator",
    "test:unit:orchestrator": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/unit/test-annotate.ts",
    "test:e2e:orchestrator": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/run-all.ts",
    "test:e2e:orchestrator:s1": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s1-fresh-run-smoke.ts",
    "test:e2e:orchestrator:s2": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s2-resume-team-default.ts",
    "test:e2e:orchestrator:s3": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s3-force-new-session.ts",
    "test:e2e:orchestrator:s4": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s4-approval-gate-tty.ts",
    "test:e2e:orchestrator:s5": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s5-phone-action-artifacts.ts",
    "test:e2e:orchestrator:s6": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s6-sandbox-acl.ts",
    "test:e2e:orchestrator:s7": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s7-resume-pi-roundtrip.ts",
    "test:e2e:orchestrator:s8": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/s8-specific-session-resume.ts",
    "test:e2e:phase-f": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f-run-all.ts",
    "test:e2e:phase-f:f1": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f1-api-smoke.ts",
    "test:e2e:phase-f:f3": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f3-local-ui.ts",
    "test:e2e:phase-f:f4": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f4-remote-ui.ts",
    "test:e2e:phase-f:f5": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f5-approval-from-ui.ts",
    "test:e2e:phase-f:f6": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f6-resume-by-team.ts",
    "test:e2e:phase-f:f7": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f7-trace-png-serving.ts",
    "test:e2e:phase-f:f8": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f8-phone4-canonical.ts",
    "test:e2e:phase-g": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g-run-all.ts",
    "test:e2e:phase-g:g1": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g1-deployed-ui-browser.ts",
    "test:e2e:phase-g:g2": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g2-f1-regression.ts",
    "test:e2e:phase-g:g3": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g3-f8-regression.ts",
    "test:e2e:phase-g:g4": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g4-local-ui-no-flag.ts",
    "test:e2e:phase-g:g5": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g5-api-flag-removed.ts",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "playwright": "^1.59.0"
  }
}
