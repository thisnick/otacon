{
  "name": "otacon",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure-as-code for a Raspberry Pi phone kiosk",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r run build",
    "generate": "pnpm -r run generate",
    "typecheck": "pnpm -r run typecheck",
    "cli": "pnpm --filter otacon-cli exec node --no-warnings --import tsx/esm src/index.ts",
    "test:e2e:phase1": "pnpm --filter otacon-orchestrator test:e2e:phase1",
    "test:e2e:phase2": "pnpm --filter otacon-orchestrator test:e2e:phase2",
    "test:e2e:phase3": "pnpm --filter otacon-orchestrator test:e2e:phase3",
    "test:e2e:phase5": "pnpm --filter otacon-orchestrator test:e2e:phase5",
    "test:e2e:phase6": "pnpm --filter otacon-orchestrator test:e2e:phase6",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0"
  }
}
