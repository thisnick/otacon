    "test:e2e:phase-i:eval:2": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-i-eval-2-deployed-workspaces.ts",
    "test:e2e:phase-i:eval:3": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-i-eval-3-deployed-teams.ts",
    "test:e2e:phase-i:eval:4": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-i-eval-4-deployed-run-flow.ts",
    "test:e2e:phase-i:eval:5": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-i-eval-5-f1-regression.ts",
