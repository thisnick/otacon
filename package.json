{
  "name": "otacon",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure-as-code for a Raspberry Pi phone kiosk",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r run build",
    "generate": "pnpm -r run generate",
    "typecheck": "pnpm -r run typecheck",
    "ui-dev": "pnpm --filter orchestrator-web dev",
    "ui-build": "pnpm --filter orchestrator-web build",
    "cli": "pnpm --filter otacon-cli exec node --no-warnings --import tsx/esm src/index.ts",
    "dev": "concurrently -k -n server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter orchestrator dev",
    "dev:web": "pnpm --filter orchestrator-web dev",
    "test:unit:orchestrator": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/unit/test-annotate.ts",
    "test:e2e:phase-f": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f-run-all.ts",
    "test:e2e:phase-f:f1": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f1-api-smoke.ts",
    "test:e2e:phase-f:f3": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f3-local-ui.ts",
    "test:e2e:phase-f:f5": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f5-approval-from-ui.ts",
    "test:e2e:phase-f:f6": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f6-resume-by-team.ts",
    "test:e2e:phase-f:f7": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f7-trace-png-serving.ts",
    "test:e2e:phase-f:f8": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-f8-phone4-canonical.ts",
    "test:e2e:phase-g": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g-run-all.ts",
    "test:e2e:phase-g:g1": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g1-deployed-ui-browser.ts",
    "test:e2e:phase-g:g2": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g2-f1-regression.ts",
    "test:e2e:phase-g:g3": "pnpm --filter orchestrator exec tsx ../../tests/orchestrator/e2e/phase-g3-f8-regression.ts",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "concurrently": "^9.0.0",
    "playwright": "^1.59.0"
  }
}
