# direnv template for `tofu/`. Copy to `.envrc`, then `direnv allow`.
#
# All TF_VAR_* + the source secrets it needs come from the otacon repo's
# `../.env` — orchestrator-v2 is self-sufficient, no sister repo needed.
#
# Required entries in `../.env` (see `.env.example` at repo root for the
# full list):
#   TF_VAR_encryption_passphrase, TF_VAR_tenancy_ocid, TF_VAR_user_ocid,
#   TF_VAR_fingerprint, TF_VAR_region, TF_VAR_compartment_ocid,
#   TF_VAR_private_key_path
#   TS_AUTH_KEY_REGISTRY    (or TS_AUTH_KEY_ORCHESTRATOR if minted separately)
#   GHCR_PULL_TOKEN          (`gh auth token` if your gh has read:packages)
#   OTACON_TOKEN             (= REGISTRY_BOOTSTRAP_ADMIN_TOKEN)
#   AI_GATEWAY_API_KEY

set -a

if [ -f ../.env ]; then
  . ../.env
fi

set +a

# ── Tailscale: orchestrator-specific key wins, else the registry key ──
# (Both nodes can share the registry key; or mint a dedicated one in the
# Tailscale admin and set TS_AUTH_KEY_ORCHESTRATOR.)
export TF_VAR_tailscale_auth_key="${TS_AUTH_KEY_ORCHESTRATOR:-${TS_AUTH_KEY_REGISTRY}}"
export TF_VAR_tailnet_domain="${TS_TAILNET_DOMAIN:-tail0437b8.ts.net}"

# ── ghcr.io pull credentials ──
# After making the package public, GHCR_PULL_TOKEN is unused by the VM but
# kept here because cloud-init's `docker login ghcr.io` runs anyway. If
# you flip the package back to private, the token must have read:packages.
export TF_VAR_ghcr_pull_user="${GHCR_PULL_USER:-thisnick}"
export TF_VAR_ghcr_pull_token="${GHCR_PULL_TOKEN:-}"
export TF_VAR_otacon_repo="${OTACON_REPO:-otacon-dev}"

# ── Orchestrator runtime secrets (cloud-init writes /opt/orchestrator/.env) ──
# OTACON_TOKEN should equal REGISTRY_BOOTSTRAP_ADMIN_TOKEN — orchestrator
# uses it to authenticate to the registry.
export TF_VAR_otacon_token="${OTACON_TOKEN:-${REGISTRY_BOOTSTRAP_ADMIN_TOKEN}}"
export TF_VAR_ai_gateway_api_key="$AI_GATEWAY_API_KEY"

# ── Optional: extra SSH keys without rotating tofu's deploy key ──
#   export TF_VAR_extra_ssh_public_keys='["ssh-ed25519 AAA..."]'
